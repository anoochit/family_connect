{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dart": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ]
      },
      "firebase-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "firebase-tools@latest",
          "mcp"
        ],
        "timeout": {
          "startup": 120000
        }
      }
    }
  }
}